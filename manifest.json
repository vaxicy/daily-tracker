{
    "manifest_version": 3,
    "name": "__MSG_name__",
    "description": "__MSG_description__",
    "version": "3.2.5",
    "default_locale": "zh_CN",
    "action": {
      "default_popup": "popup.html",
      "default_title": "吃喝拉撒 - Health Tracker",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "permissions": [
      "notifications",
      "storage",
      "alarms"
    ],
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
