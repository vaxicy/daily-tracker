{
    "manifest_version": 3,
    "name": "吃喝拉撒 - Daily Habit Tracker 健康习惯追踪",
    "description": "记录饮食、饮水、排便、排尿，全方位健康习惯追踪器。Free daily health habit tracker for Chrome - track diet, water, bowel, bladder.",
    "version": "3.2.1",
    "action": {
      "default_popup": "popup.html",
      "default_title": "吃喝拉撒 - Health Tracker",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "permissions": [
      "notifications",
      "storage",
      "alarms"
    ],
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
